<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's logic: no WPF, so it builds and its tests run on any OS.
       Windows-only pieces (DPAPI, registry, Zone.Identifier) sit behind small interfaces. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wintainium.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wintainium.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the recognized-apps catalog, built in so the exe needs no files beside it -->
    <EmbeddedResource Include="..\..\known-apps.json" LogicalName="Wintainium.known-apps.json" Link="Scan\known-apps.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>

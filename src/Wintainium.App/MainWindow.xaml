<Window x:Class="Wintainium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wintainium" Width="1120" Height="740" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" Foreground="#CDD6F4"
        FontFamily="Segoe UI" FontSize="13" Icon="/Assets/icon.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="170"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="20,16,20,6">
      <TextBlock Text="Wintainium" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="Summary" Foreground="#A6ADC8" Margin="0,2,0,0" Text="Checking..."/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="20,8,20,4">
      <Button x:Name="BtnUpdate" Style="{StaticResource Primary}" Click="BtnUpdate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;"/><TextBlock Text="Update selected"/></StackPanel>
      </Button>
      <Button x:Name="BtnAll" Style="{StaticResource Btn}" Click="BtnAll_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;"/><TextBlock Text="Update all"/></StackPanel>
      </Button>
      <Button x:Name="BtnNotes" Style="{StaticResource Btn}" Click="BtnNotes_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/><TextBlock Text="What's new"/></StackPanel>
      </Button>
      <Button x:Name="BtnLaunch" Style="{StaticResource Btn}" Click="BtnLaunch_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/><TextBlock Text="Launch"/></StackPanel>
      </Button>
      <Button x:Name="BtnPage" Style="{StaticResource Btn}" Click="BtnPage_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;"/><TextBlock Text="Release page"/></StackPanel>
      </Button>
      <Button x:Name="BtnFolder" Style="{StaticResource Btn}" Click="BtnFolder_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/><TextBlock Text="Open folder"/></StackPanel>
      </Button>
      <Button x:Name="BtnAdd" Style="{StaticResource Btn}" Click="BtnAdd_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;"/><TextBlock Text="Add app"/></StackPanel>
      </Button>
      <Button x:Name="BtnRefresh" Style="{StaticResource Btn}" Click="BtnRefresh_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/><TextBlock Text="Refresh"/></StackPanel>
      </Button>
      <Button x:Name="BtnForce" Style="{StaticResource Btn}" Click="BtnForce_Click"
              ToolTip="Ignore the 60-minute cache and ask every release source again">
        <TextBlock Text="Re-check all"/>
      </Button>
      <Button x:Name="BtnScan" Style="{StaticResource Btn}" Click="BtnScan_Click"
              ToolTip="Find apps already installed on this PC and add them">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;"/><TextBlock Text="Scan"/></StackPanel>
      </Button>
      <Button x:Name="BtnSetup" Style="{StaticResource Btn}" Click="BtnSetup_Click"
              ToolTip="Folders, GitHub token and shortcuts">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/><TextBlock Text="Setup"/></StackPanel>
      </Button>
    </WrapPanel>

    <DockPanel Grid.Row="2" Margin="20,0,20,8" LastChildFill="False">
      <Grid DockPanel.Dock="Left" Width="300">
        <TextBox x:Name="Search" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                 Padding="8,5" CaretBrush="#CDD6F4" VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
        <TextBlock x:Name="SearchHint" Text="Search apps..." Foreground="#6C7086" Margin="11,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <CheckBox x:Name="OnlyUpdates" DockPanel.Dock="Left" Content="Only show updates" Foreground="#CDD6F4"
                VerticalAlignment="Center" Margin="16,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      <TextBlock DockPanel.Dock="Right" Foreground="#6C7086" VerticalAlignment="Center"
                 Text="Double-click to update  -  right-click for more  -  F5 to refresh"/>
    </DockPanel>

    <DataGrid x:Name="Grid" Grid.Row="3" Margin="20,0,20,10" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None"
              Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#232336"
              BorderThickness="0" Foreground="#CDD6F4" CanUserAddRows="False" CanUserResizeRows="False"
              RowHeight="34" FocusVisualStyle="{x:Null}"
              MouseDoubleClick="Grid_MouseDoubleClick" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#181825"/>
          <Setter Property="Foreground" Value="#A6ADC8"/>
          <Setter Property="Padding" Value="10,9"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="10,0"/>
          <Setter Property="Foreground" Value="#CDD6F4"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#45475A"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.ContextMenu>
        <ContextMenu x:Name="RowMenu" Opened="RowMenu_Opened">
          <MenuItem Header="Update" Click="BtnUpdate_Click"/>
          <MenuItem Header="What's new" Click="BtnNotes_Click"/>
          <MenuItem Header="Launch" Click="BtnLaunch_Click"/>
          <Separator/>
          <MenuItem Header="Open release page" Click="MenuPage_Click"/>
          <MenuItem Header="Open folder" Click="MenuFolder_Click"/>
          <Separator/>
          <MenuItem Header="Remove from list..." Click="MenuRemove_Click"/>
          <Separator x:Name="GoldSep"/>
          <MenuItem x:Name="GoldItem" Header="Show Wintainium in gold" IsCheckable="True" Click="GoldItem_Click"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Gold}" Value="True">
                  <Setter Property="Foreground" Value="#F5C542"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="ToolTip" Value="Wintainium keeping itself up to date (right-click to turn off the gold)"/>
                  <Setter Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#F5C542" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTemplateColumn Header="Status" Width="140" SortMemberPath="Status">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border x:Name="pill" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Background="#313244">
                <TextBlock x:Name="pt" Text="{Binding Status}" FontSize="12" Foreground="#A6ADC8"/>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="UPDATE">
                  <Setter TargetName="pill" Property="Background" Value="#F9E2AF"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#1E1E2E"/>
                  <Setter TargetName="pt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="up to date">
                  <Setter TargetName="pill" Property="Background" Value="#26352B"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#A6E3A1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="lookup failed">
                  <Setter TargetName="pill" Property="Background" Value="#3B2530"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="rate limited">
                  <Setter TargetName="pill" Property="Background" Value="#3B2530"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="site busy">
                  <Setter TargetName="pill" Property="Background" Value="#3A3326"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#FAB387"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="token rejected">
                  <Setter TargetName="pill" Property="Background" Value="#3B2530"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="exe not found">
                  <Setter TargetName="pill" Property="Background" Value="#3B2530"/>
                  <Setter TargetName="pt" Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="1.2*"/>
        <DataGridTextColumn Header="Latest" Binding="{Binding Latest}" Width="1.5*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="ToolTip" Value="{Binding Latest}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Released" Binding="{Binding Released}" Width="100"/>
        <DataGridTextColumn Header="Update via" Binding="{Binding Via}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="4" Margin="20,0,20,12" Background="#181825" CornerRadius="8" Padding="10,6">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Log">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,1"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="5" Background="#11111B" Padding="20,6">
      <TextBlock x:Name="StatusText" Foreground="#A6ADC8" Text="Ready"/>
    </Border>
  </Grid>
</Window>
